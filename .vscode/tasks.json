{
    "version": "2.0.0",
    "tasks": [
        {
            "type": "cppbuild",
            "label": "Compilar Projeto TAD",
            "command": "gcc",
            "args": [
                "-Wall",
                "-Wextra",
                "-g3",
                "${workspaceFolder}\\*.c",
                "${workspaceFolder}\\pilhas\\*.c",
                "${workspaceFolder}\\listas\\*.c",
                "${workspaceFolder}\\filas\\*.c",
                "-o",
                "${workspaceFolder}\\output\\main.exe"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Tarefa manual para compilar main e TADs em subpastas."
        }
    ]
}